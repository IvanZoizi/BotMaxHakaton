# Домена пилота нет — стенд живёт на голом IP через sslip.io
# (49-12-80-137.sslip.io резолвится в 49.12.80.137), сертификат выпущен
# certbot'ом на это имя, см. scripts/init-letsencrypt.sh.

server {
    listen 80;
    server_name 49-12-80-137.sslip.io;

    # Сюда certbot кладёт ACME-challenge при выпуске/продлении сертификата
    # (см. certbot-сервис в docker-compose.yaml).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name 49-12-80-137.sslip.io;

    ssl_certificate     /etc/letsencrypt/live/49-12-80-137.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/49-12-80-137.sslip.io/privkey.pem;

    client_max_body_size 20m;
    root /usr/share/nginx/html;
    index index.html;

    # Мини-апп собран nginx/Dockerfile (multi-stage) с VITE_API_URL=/api —
    # тот же origin, что отдаёт эту страницу, поэтому CORS не нужен.
    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Сюда MAX шлёt обновления вебхуком (BOT_WEBHOOK_URL=https://<домен>/bot/webhook)
    # и сюда же ходит api, чтобы попросить бота отправить уведомление
    # (см. bot/app/notify.py) — оба случая проксируются на bot:8080 как есть.
    location /bot/ {
        proxy_pass http://bot:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: неизвестные пути (React Router) отдаём как index.html, а не 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
