# HTTP-заглушка на старте: TLS (сертификаты Let's Encrypt/certbot) добавим,
# когда будет известен домен пилота — конфиг сертификатов не придумываем заранее.
server {
    listen 80;
    server_name _;

    client_max_body_size 20m;
    root /usr/share/nginx/html;
    index index.html;

    # Мини-апп собран nginx/Dockerfile (multi-stage) с VITE_API_URL=/api —
    # тот же origin, что отдаёт эту страницу, поэтому CORS не нужен.
    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Сюда MAX шлёt обновления вебхуком (BOT_WEBHOOK_URL=https://<домен>/bot/webhook)
    # и сюда же ходит api, чтобы попросить бота отправить уведомление
    # (см. bot/app/notify.py) — оба случая проксируются на bot:8080 как есть.
    location /bot/ {
        proxy_pass http://bot:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: неизвестные пути (React Router) отдаём как index.html, а не 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
