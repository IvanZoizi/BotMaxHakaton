# Base URL the frontend calls for the 16-endpoint API. Default '/api' assumes
# the frontend is served from the same nginx as the backend (docker-compose) —
# same-origin, no CORS needed. For `npm run dev` against a dockerized backend
# on the host, copy this to .env.local and point it at nginx's published port:
# VITE_API_URL=http://localhost/api
VITE_API_URL=/api

# 'mock' falls back to the in-memory fixtures in src/api/mockApi.ts (no
# backend required). Anything else (or unset) calls the real API.
VITE_API_MODE=http
