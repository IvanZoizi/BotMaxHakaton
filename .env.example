POSTGRES_DB=smena
POSTGRES_USER=smena
POSTGRES_PASSWORD=change-me

# dev — принимает заголовок X-Debug-Employee-Id вместо реальной подписи MAX initData.
# prod — только X-Max-Init-Data с HMAC-проверкой токеном бота.
AUTH_MODE=dev

# Один и тот же реальный токен бота (от @MasterBot в MAX) — BOT_TOKEN читает
# api (HMAC-проверка initData), MAX_BOT_TOKEN читает bot (вызовы MAX Bot API).
BOT_TOKEN=replace-with-max-bot-token
MAX_BOT_TOKEN=replace-with-max-bot-token
FILE_SIGNING_SECRET=replace-with-random-secret

# Публичный URL вебхука бота, например https://<домен пилота>/bot/webhook —
# без него бот запускается, но MAX не будет слать ему обновления (см.
# bot/app/main.py on_dispatcher_started). Секрет — с чем сверяет заголовок
# X-Max-Bot-Api-Secret; тот же секрет уходит в bot.subscribe_webhook().
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=replace-with-random-secret
# Секрет для POST /internal/notify/* — им api просит бота отправить
# уведомление (см. bot/app/notify.py, api/app/notify_client.py).
BOT_INTERNAL_NOTIFY_SECRET=replace-with-random-secret

# Домен мини-аппа — пока не известен (пилот ещё не запущен), заглушка для
# LinkButton-фолбэка в bot/app/keyboards.py.
MINIAPP_URL=https://smena.example.com

# Как часто api проверяет дедлайны заявок и шлёт напоминания (README §9
# №13) — секунды. 3600 (час) разумно для прода; для демо можно поставить
# меньше, чтобы не ждать час, чтобы увидеть напоминание.
REMINDER_SWEEP_INTERVAL_SECONDS=3600
